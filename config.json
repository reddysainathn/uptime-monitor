{
  "check_interval_sec": 1.0,
  "fail_threshold": 2,
  "success_threshold": 2,
  "ping_timeout_sec": 0.8,
  "tcp_timeout_sec": 2.0,
  "ping_targets": [
    "1.1.1.1",
    "8.8.8.8",
    "9.9.9.9"
  ],
  "tcp_check": {
    "host": "1.1.1.1",
    "port": 443
  },
  "sleep_gap_sec": 5.0,
  "dashboard_port": 8899,
  "dashboard_regen_sec": 10,
