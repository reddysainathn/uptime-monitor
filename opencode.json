      "~/Library/Caches/UptimeMonitor/**": "deny",
      "~/.local/share/uptime-monitor/**": "deny"
    },
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "lsp": "allow",
    "skill": "ask",
    "doom_loop": "ask"
