      "**/*.db": "deny",
      "**/*.db-*": "deny",
      "**/*.log": "deny",
      "/etc/**": "deny"
    },
    "edit": {
      "*": "ask",
      "**/.env*": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.gnupg/**": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/reports/**": "deny",
      "**/*.db*": "deny",
      "**/*.log": "deny",
      "/etc/**": "deny"
    },
    "glob": {
